# Copiază acest fișier ca `.env.local` și completează valorile reale.
# `.env.local` NU ajunge în git — acolo stau secretele.
# După orice modificare, repornește serverul: valorile se citesc la pornire.

# Panoul de administrare (/admin)
ADMIN_EMAIL=adresa@exemplu.com
ADMIN_PAROLA=alege-o-parola-lunga
# Șir aleatoriu care semnează cookie-ul de sesiune. Generează unul nou,
# de exemplu cu:  node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
ADMIN_SECRET=inlocuieste-cu-un-sir-aleatoriu-lung

# Notificări Telegram la fiecare comandă nouă (opțional).
# Lasă-le goale ca să oprești notificările — magazinul merge la fel.
# Tokenul se obține de la @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
